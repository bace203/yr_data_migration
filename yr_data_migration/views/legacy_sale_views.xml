<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="yr_legacy_sale_line_view_list" model="ir.ui.view">
        <field name="name">yr.legacy.sale.line.list</field>
        <field name="model">yr.legacy.sale.line</field>
        <field name="arch" type="xml">
            <list string="Ventes fastmag" create="0" edit="0">
                <header>
                    <button name="action_link_employees" type="object" string="Rattacher aux employés"
                            display="always" groups="loyalty_tier_marketing.group_loyalty_tier_manager"/>
                </header>
                <field name="date"/>
                <field name="store_id" optional="show"/>
                <field name="pos_config_id" optional="show"/>
                <field name="shop_code" optional="hide"/>
                <field name="pos_error" optional="show"/>
                <field name="ticket"/>
                <field name="seller_name" optional="show"/>
                <field name="cashier_name" optional="show"/>
                <field name="seller_id" optional="hide"/>
                <field name="cashier_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="card" optional="hide"/>
                <field name="legacy_client_id" optional="hide"/>
                <field name="pos_order_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="axe" optional="hide"/>
                <field name="qty" sum="Total"/>
                <field name="price_unit" optional="hide"/>
                <field name="discount" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="yr_legacy_sale_line_view_pivot" model="ir.ui.view">
        <field name="name">yr.legacy.sale.line.pivot</field>
        <field name="model">yr.legacy.sale.line</field>
        <field name="arch" type="xml">
            <pivot string="Ventes par vendeur" sample="1">
                <field name="seller_name" type="row"/>
                <field name="store_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="yr_legacy_sale_line_view_graph" model="ir.ui.view">
        <field name="name">yr.legacy.sale.line.graph</field>
        <field name="model">yr.legacy.sale.line</field>
        <field name="arch" type="xml">
            <graph string="Ventes par vendeur" type="bar" sample="1">
                <field name="seller_name"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="yr_legacy_sale_line_view_search" model="ir.ui.view">
        <field name="name">yr.legacy.sale.line.search</field>
        <field name="model">yr.legacy.sale.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="seller_name" string="Vendeur"/>
                <field name="cashier_name" string="Caissier"/>
                <field name="legacy_client_id"/>
                <field name="ticket"/>
                <field name="partner_id"/>
                <field name="card"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="store_id"/>
                <filter name="articles" string="Articles (sans timbre)" domain="[('is_stamp', '=', False)]"/>
                <filter name="identified" string="Clients identifiés" domain="[('card', '!=', False)]"/>
                <filter name="no_pos_order" string="Sans commande PdV" domain="[('pos_order_id', '=', False)]"/>
                <filter name="pos_error" string="Commande en erreur" domain="[('pos_error', '!=', False)]"/>
                <filter name="no_store" string="Magasin non reconnu" domain="[('store_id', '=', False)]"/>
                <filter name="code_no_card" string="Code client sans carte"
                        domain="[('card', '=', False), ('legacy_client_id', '!=', False)]"/>
                <filter name="gifts" string="Offerts / remisés" domain="[('discount', '>', 0)]"/>
                <filter name="no_seller" string="Vendeur non rattaché" domain="[('seller_id', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="by_seller" string="Vendeur" context="{'group_by': 'seller_name'}"/>
                    <filter name="by_cashier" string="Caissier" context="{'group_by': 'cashier_name'}"/>
                    <filter name="by_store" string="Magasin" context="{'group_by': 'store_id'}"/>
                    <filter name="by_pos" string="Point de vente" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="by_axe" string="Axe" context="{'group_by': 'axe'}"/>
                    <filter name="by_day" string="Jour" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_yr_legacy_sale_line" model="ir.actions.act_window">
        <field name="name">Ventes fastmag (détail)</field>
        <field name="res_model">yr.legacy.sale.line</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_articles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune vente fastmag importée</p>
            <p>Importez le fichier « Détail ventes » dans Configuration › Reprise fastmag.</p>
        </field>
    </record>
    <menuitem id="menu_yr_legacy_sale_line" name="Ventes fastmag par vendeur"
              parent="loyalty_tier_marketing.menu_loyalty_tier_dashboard" action="action_yr_legacy_sale_line"
              sequence="90"/>
    <menuitem id="menu_yr_legacy_sale_line_pos" name="Ventes fastmag par vendeur"
              parent="point_of_sale.menu_point_rep" action="action_yr_legacy_sale_line" sequence="90"
              groups="point_of_sale.group_pos_manager"/>
    <record id="yr_unknown_article_view_list" model="ir.ui.view">
        <field name="name">yr.unknown.article.list</field>
        <field name="model">yr.unknown.article</field>
        <field name="arch" type="xml">
            <list string="Articles inconnus (ventes fastmag)" create="false" edit="false" delete="false"
                  decoration-success="in_catalog">
                <field name="code"/>
                <field name="name"/>
                <field name="motifs"/>
                <field name="lines" sum="Total"/>
                <field name="tickets" optional="show"/>
                <field name="qty" optional="show" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="avg_price" optional="show"/>
                <field name="avg_discount" optional="show"/>
                <field name="date_first" optional="show"/>
                <field name="date_last" optional="show"/>
                <field name="shops" optional="hide"/>
                <field name="axe" optional="hide"/>
                <field name="product_line" optional="hide"/>
                <field name="reasons" optional="hide"/>
                <field name="product_ref" optional="hide"/>
                <field name="barcode" optional="hide"/>
                <field name="in_catalog" widget="boolean" optional="show"/>
                <button name="action_open_lines" type="object" icon="fa-list" title="Lignes de vente de cet article"/>
            </list>
        </field>
    </record>
    <record id="yr_unknown_article_view_search" model="ir.ui.view">
        <field name="name">yr.unknown.article.search</field>
        <field name="model">yr.unknown.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="motifs"/>
                <field name="axe"/>
                <field name="product_line"/>
                <filter name="in_catalog" string="Dans le catalogue maintenant (à réimporter)" domain="[('in_catalog', '=', True)]"/>
                <filter name="not_in_catalog" string="Toujours absents du catalogue" domain="[('in_catalog', '=', False)]"/>
                <filter name="with_motif" string="Avec un motif" domain="[('motifs', '!=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="g_motif" string="Motif" context="{'group_by': 'motifs'}"/>
                    <filter name="g_axe" string="Axe" context="{'group_by': 'axe'}"/>
                    <filter name="g_line" string="Ligne" context="{'group_by': 'product_line'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_yr_unknown_article" model="ir.actions.act_window">
        <field name="name">Articles inconnus (ventes fastmag)</field>
        <field name="res_model">yr.unknown.article</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Aucun article inconnu</p>
            <p>Tous les articles des ventes importées sont dans le catalogue.</p></field>
    </record>
    <record id="action_yr_unknown_article_export" model="ir.actions.server">
        <field name="name">Exporter les articles inconnus (Excel)</field>
        <field name="model_id" ref="model_yr_unknown_article"/>
        <field name="state">code</field>
        <field name="code">action = model.action_export_excel()</field>
    </record>
    <menuitem id="menu_yr_unknown_article" name="Articles inconnus (ventes fastmag)"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_unknown_article" sequence="92"/>
    <menuitem id="menu_yr_unknown_article_export" name="Exporter les articles inconnus (Excel)"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_unknown_article_export"
              sequence="93"/>
</odoo>
