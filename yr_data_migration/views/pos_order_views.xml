<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_order_form_seller" model="ir.ui.view">
        <field name="name">pos.order.form.seller</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="yr_seller_id" readonly="0" options="{'no_create': True}"/>
                <field name="yr_seller_code_legacy" invisible="not yr_seller_code_legacy"/>
                <field name="yr_fastmag_ticket" invisible="not yr_fastmag_ticket"/>
                <field name="yr_seller_name" invisible="not yr_seller_name"/>
                <field name="yr_cashier_name" invisible="not yr_cashier_name"/>
                <field name="yr_fastmag_card" invisible="not yr_fastmag_card"/>
            </field>
        </field>
    </record>
    <record id="pos_order_list_seller" model="ir.ui.view">
        <field name="name">pos.order.list.seller</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <!-- at the end: the list may have been changed by other modules (no cashier column) -->
            <xpath expr="//list" position="inside">
                <field name="yr_seller_id" optional="show"/>
                <field name="yr_seller_name" optional="show"/>
                <field name="yr_cashier_name" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="pos_order_search_seller" model="ir.ui.view">
        <field name="name">pos.order.search.seller</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="yr_seller_id"/>
                <field name="yr_seller_name"/>
                <field name="yr_cashier_name"/>
                <field name="yr_fastmag_ticket"/>
                <filter name="yr_fastmag" string="Historique fastmag" domain="[('yr_fastmag_ticket', '!=', False)]"/>
                <filter name="yr_not_fastmag" string="Ventes Posify" domain="[('yr_fastmag_ticket', '=', False)]"/>
                <filter name="yr_by_seller" string="Vendeur" context="{'group_by': 'yr_seller_id'}"/>
                <filter name="yr_by_seller_name" string="Vendeur (fastmag)" context="{'group_by': 'yr_seller_name'}"/>
                <filter name="yr_by_cashier_name" string="Caissier (fastmag)"
                        context="{'group_by': 'yr_cashier_name'}"/>
            </xpath>
        </field>
    </record>
</odoo>
