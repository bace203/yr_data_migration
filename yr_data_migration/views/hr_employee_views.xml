<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_fastmag" model="ir.ui.view">
        <field name="name">hr.employee.form.fastmag</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="yr_fastmag_name" placeholder="ex. JBELI RYM"/>
                <field name="yr_store_id"/>
                <field name="yr_logistic_code"/>
            </field>
        </field>
    </record>
</odoo>
