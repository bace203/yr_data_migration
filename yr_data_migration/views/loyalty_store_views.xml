<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_store_form_fastmag" model="ir.ui.view">
        <field name="name">loyalty.store.form.fastmag</field>
        <field name="model">loyalty.store</field>
        <field name="inherit_id" ref="loyalty_tier_marketing.loyalty_store_view_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="yr_fastmag_code" placeholder="ex. YR_YOUG"/>
            </field>
        </field>
    </record>
    <record id="loyalty_store_list_fastmag" model="ir.ui.view">
        <field name="name">loyalty.store.list.fastmag</field>
        <field name="model">loyalty.store</field>
        <field name="inherit_id" ref="loyalty_tier_marketing.loyalty_store_view_list"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="yr_fastmag_code" optional="show"/>
            </field>
        </field>
    </record>
    <record id="res_company_form_fastmag_code" model="ir.ui.view">
        <field name="name">res.company.form.fastmag.code</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="d-flex align-items-center gap-2">
                    <label for="yr_fastmag_code" class="mb-0 text-muted">Code magasin fastmag</label>
                    <field name="yr_fastmag_code" placeholder="YR_MAHSOUNA,YR_MAHSN" class="w-auto"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="res_company_list_fastmag_code" model="ir.ui.view">
        <field name="name">res.company.list.fastmag.code</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="yr_fastmag_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
