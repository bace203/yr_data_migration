<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="yr_migration_import_view_form" model="ir.ui.view">
        <field name="name">yr.migration.import.form</field>
        <field name="model">yr.migration.import</field>
        <field name="arch" type="xml">
            <form string="Reprise fastmag">
                <field name="state" invisible="1"/>
                <field name="log_id" invisible="1"/>
                <widget name="yr_import_progress"/>
                <div invisible="state != 'draft'">
                    <p class="text-muted">
                        Choisissez un fichier : il est reconnu tout seul. Ordre conseillé :
                        <b>magasins</b> (et vendeurs), <b>articles</b> (fichier « Liste des articles »),
                        <b>clients</b> (fichier « Liste des clients détail »), puis <b>détail des ventes</b>.
                        Un fichier peut être réimporté : rien n'est créé en
                        double. Un client sans vrai numéro de carte fidélité n'est pas importé, les coupons du détail
                        des ventes sont ignorés. Après chaque import : résumé et rapport détaillé (Excel).
                    </p>
                    <group>
                        <group>
                            <field name="file" filename="filename" invisible="file_ids"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_type" invisible="not file"
                                   decoration-success="file_type" placeholder="Non reconnu : choisissez"/>
                        </group>
                    </group>
                    <group string="Ou plusieurs fichiers : file d'attente" invisible="file">
                        <field name="file_ids" widget="yr_file_queue" nolabel="1" colspan="2"/>
                        <field name="skip_done" invisible="not file_ids"/>
                        <div class="text-muted" colspan="2" invisible="not file_ids">
                            Les fichiers sont envoyés un par un, puis importés l'un après l'autre en arrière-plan,
                            sans que vous restiez devant l'écran : vous pouvez fermer la page. Ordre : magasins,
                            articles, clients, puis ventes ; pour un même type, par numéro de partie du nom
                            (ventes_partie_2 avant ventes_partie_10). Les options ci-dessous s'appliquent à tous les
                            fichiers. Un fichier en échec n'arrête pas les autres : relancez-le depuis la file.
                        </div>
                    </group>
                    <field name="previous_import" invisible="not previous_import" nolabel="1"/>
                    <group invisible="not file_ids and file_type != 'article'" string="Articles">
                        <field name="create_categories"/>
                        <field name="update_prices"/>
                        <field name="archive_inactive"/>
                    </group>
                    <group invisible="not file_ids and file_type != 'sales_detail'" string="Détail des ventes">
                        <field name="create_pos_orders"/>
                        <field name="deduce_motif"/>
                        <field name="import_no_card"/>
                        <field name="create_sellers"/>
                        <field name="update_purchases"/>
                    </group>
                    <div invisible="file_type not in ('sellers', 'workbook')" class="text-muted mb-2">
                        Vendeurs : chaque vendeur devient un employé du magasin (code logistique gardé) et est proposé
                        dans les caisses de ce magasin (« Vendeur avant paiement »).
                        <span invisible="file_type != 'workbook'">Toutes les feuilles reconnues sont importées,
                        les magasins d'abord.</span>
                    </div>
                    <group invisible="not file_ids and file_type not in ('stores', 'workbook')" string="Magasins">
                        <field name="store_companies"/>
                        <field name="store_pos"/>
                    </group>
                    <div invisible="file_type != 'stores'" class="text-muted mb-2">
                        Une ligne par magasin : nom et code (ex. AZUR | 23), ou nom, code fastmag et numéro
                        (ex. CARREFOUR | YR_CARR | 2). Les magasins absents sont créés,
                        les autres reçoivent le code (l'ancien code reste reconnu). « eshop » devient le site web.
                    </div>
                    <div invisible="file_type != 'client_codes'" class="text-muted mb-2">
                        Liste client fastmag : le code client (Y88074) des fichiers de ventes et sa carte fidélité.
                        Les ventes sans carte sont rattachées au client grâce à ce code, même celles déjà importées.
                        Un code sans vraie carte (vide, 000000…) est gardé mais ne crée pas de client.
                    </div>
                    <div invisible="file_type != 'sales_detail'" class="text-muted mb-2">
                        Les noms « Vendeur » et « Caissier » (Utilisateur) de fastmag sont gardés sur chaque ligne,
                        même s'ils ne correspondent à aucun employé. Sans carte fidélité, le client est retrouvé
                        par son code client (Y…) grâce à la « Liste client ».
                    </div>
                    <group invisible="not file_ids and file_type not in ('client_new', 'client_old')" string="Clients">
                        <field name="update_existing"/>
                        <field name="year_2000_unknown" invisible="file_type != 'client_old'"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <field name="result"/>
                </div>
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"
                            invisible="state != 'draft' or file_ids"/>
                    <button name="action_import_queue" string="Mettre en file d'attente" type="object"
                            class="btn-primary" invisible="state != 'draft' or not file_ids"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_yr_migration_import" model="ir.actions.act_window">
        <field name="name">Reprise fastmag</field>
        <field name="res_model">yr.migration.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_yr_migration_import" name="Reprise fastmag (magasins, articles, clients, ventes)"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_migration_import"
              sequence="90"/>
    <record id="yr_migration_queue_view_list" model="ir.ui.view">
        <field name="name">yr.migration.queue.list</field>
        <field name="model">yr.migration.queue</field>
        <field name="arch" type="xml">
            <list string="File d'attente des imports" create="false" decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'" decoration-muted="state in ('done', 'skipped')">
                <field name="name"/>
                <field name="file_type" optional="show"/>
                <field name="part" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="label"/>
                <field name="progress" widget="progressbar"/>
                <field name="message"/>
                <field name="log_id" optional="show"/>
                <button name="action_retry" type="object" icon="fa-repeat" string="Relancer"
                        invisible="state not in ('failed', 'skipped')"/>
                <button name="action_cancel" type="object" icon="fa-trash" string="Retirer de la file"
                        invisible="state not in ('pending', 'failed')"/>
            </list>
        </field>
    </record>
    <record id="action_yr_migration_queue" model="ir.actions.act_window">
        <field name="name">File d'attente des imports</field>
        <field name="res_model">yr.migration.queue</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Aucun fichier en attente</p>
            <p>Depuis « Reprise fastmag », déposez plusieurs fichiers puis « Mettre en file d'attente » : ils sont
            importés l'un après l'autre en arrière-plan. Actualisez la page pour voir l'avancement.</p></field>
    </record>
    <menuitem id="menu_yr_migration_queue" name="File d'attente des imports fastmag"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_migration_queue"
              sequence="91"/>
    <record id="yr_migration_log_view_list" model="ir.ui.view">
        <field name="name">yr.migration.log.list</field>
        <field name="model">yr.migration.log</field>
        <field name="arch" type="xml">
            <list string="Imports fastmag" create="false" decoration-warning="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="date_start"/>
                <field name="name"/>
                <field name="file_type"/>
                <field name="done"/>
                <field name="total"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="user_id" optional="show"/>
                <field name="date_end" optional="hide"/>
                <field name="report_file" filename="report_filename" optional="show"/>
                <field name="report_filename" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="yr_migration_log_view_form" model="ir.ui.view">
        <field name="name">yr.migration.log.form</field>
        <field name="model">yr.migration.log</field>
        <field name="arch" type="xml">
            <form string="Import fastmag" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="file_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="done"/>
                            <field name="total"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="result"/>
                    <group invisible="not report_file">
                        <field name="report_file" filename="report_filename"/>
                        <field name="report_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_yr_migration_log" model="ir.actions.act_window">
        <field name="name">Historique des imports fastmag</field>
        <field name="res_model">yr.migration.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_yr_migration_log" name="Historique des imports fastmag"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_migration_log"
              sequence="91"/>
    <record id="yr_client_code_view_list" model="ir.ui.view">
        <field name="name">yr.client.code.list</field>
        <field name="model">yr.client.code</field>
        <field name="arch" type="xml">
            <list string="Codes clients fastmag" create="false" edit="false" decoration-muted="not card">
                <field name="code"/>
                <field name="card"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date" optional="show"/>
                <field name="points" optional="show"/>
                <field name="category" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="yr_client_code_view_search" model="ir.ui.view">
        <field name="name">yr.client.code.search</field>
        <field name="model">yr.client.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="card"/>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="no_card" string="Sans vraie carte" domain="[('card', '=', False)]"/>
                <filter name="no_partner" string="Carte sans fiche client"
                        domain="[('card', '!=', False), ('partner_id', '=', False)]"/>
                <filter name="linked" string="Rattachés à un client" domain="[('partner_id', '!=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_yr_client_code" model="ir.actions.act_window">
        <field name="name">Codes clients fastmag</field>
        <field name="res_model">yr.client.code</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun code client fastmag</p>
            <p>Importez le fichier « Liste client » (CodeClient, Cartefidelite) dans Reprise fastmag.</p>
        </field>
    </record>
    <menuitem id="menu_yr_client_code" name="Codes clients fastmag (Y…)"
              parent="loyalty_tier_marketing.menu_loyalty_tier_config" action="action_yr_client_code"
              sequence="92"/>
    <menuitem id="menu_yr_migration_import_stock" name="Reprise fastmag (articles)"
              parent="stock.menu_stock_config_settings" action="action_yr_migration_import" sequence="90"
              groups="stock.group_stock_manager"/>
</odoo>
